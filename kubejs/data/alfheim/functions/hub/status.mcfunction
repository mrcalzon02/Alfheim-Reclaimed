# Safe at the server console: reports placement phase, source scoreboards and the real baked marker when it is loaded.

say [Alfheim] --- world hub status ---
execute unless score #created alfheim.hub matches 1 run say [Alfheim] hub: NOT CREATED -- /function alfheim:hub/create
execute if score #created alfheim.hub matches 1 unless score #final alfheim.hub matches 1 run say [Alfheim] hub: PROVISIONAL -- waiting for baked Greatbole anchor
execute if score #final alfheim.hub matches 1 run say [Alfheim] hub: BAKED -- Greatbole complete; checking marker visibility
execute if score #final alfheim.hub matches 1 unless score #created alfheim.hub matches 1 run say [Alfheim] WARNING: final flag set but created flag is missing
execute unless score #final alfheim.hub matches 1 if score #attempts alfheim.hub matches 61.. run say [Alfheim] WARNING: hub placement retry limit reached -- /function alfheim:hub/reset then /function alfheim:hub/create

# Scoreboard probes are read-only; these also work from a headless console.
scoreboard players get #attempts alfheim.hub
scoreboard players get #place_result alfheim.hub
scoreboard players get #created alfheim.hub
scoreboard players get #final alfheim.hub

# A saved baked marker can load after the scoreboard during server startup.
execute in mythicbotany:alfheim run data get entity @e[type=minecraft:marker,tag=alfheim_hub_baked,tag=!alfheim_hub_buried,limit=1] Pos
execute if score #final alfheim.hub matches 1 in mythicbotany:alfheim unless entity @e[type=minecraft:marker,tag=alfheim_hub_baked,tag=!alfheim_hub_buried,limit=1] run say [Alfheim] WARNING: baked marker not selectable yet -- check loaded chunks
execute if score #created alfheim.hub matches 1 unless score #final alfheim.hub matches 1 in mythicbotany:alfheim unless entity @e[type=minecraft:marker,tag=alfheim_hub,tag=!alfheim_hub_buried,limit=1] run say [Alfheim] WARNING: provisional spawn marker not selectable
