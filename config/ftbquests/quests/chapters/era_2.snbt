	quests: [
		{
			description: [
				"Set the daisy beside plain stone this time, not wood."
				""
				"Livingrock is the material every elven workshop is built from. It is not stronger than stone. It simply holds a charge, the way a good student holds an idea."
			]
			id: "2BB873E5C40AD505"
			rewards: [{
