			x: 3.0d
			y: 0.0d
		}
		{
			description: [
				"Mana in a pool is mana that stays where you left it."
				""
				"Take some with you. You will need it far from home more often than you expect."
			]
			id: "1B7AF8E6D86B17CC"
			rewards: [{
