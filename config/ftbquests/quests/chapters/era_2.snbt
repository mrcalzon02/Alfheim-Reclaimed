		{
			description: [
				"Now put the three together and stand back."
				""
				"A flower that burns, a spreader that throws, a pool that holds. That is the whole of our industry in miniature, and every factory you build hereafter is this repeated until it is embarrassing."
			]
			id: "7A4284C3A8388274"
			rewards: [{
				id: "650638860960FD1E"
				item: "botania:mana_pearl"
