			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["2BB873E5C40AD505"]
			description: [
				"The Diluted Pool taught you the shape. This is the real one."
				""
				"Everything you build for the next nine eras draws from a pool like this. Put it somewhere you are willing to walk to a thousand times."
			]
			id: "5AF1BF292F695BFC"
			rewards: [{
