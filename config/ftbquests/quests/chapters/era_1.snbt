			y: 3.0d
		}
		{
			dependencies: ["069CAEB6440B20D9"]
			description: [
				"Bind yourself a book and write one glyph in it."
				""
				"I am a botanist. This is not my art, and I have watched enough students hurt themselves with it to be honest about that. Go slowly. It answers faster than a flower does, and that is exactly the danger."
			]
			id: "7CE20EF56A24AEFF"
			rewards: [{
