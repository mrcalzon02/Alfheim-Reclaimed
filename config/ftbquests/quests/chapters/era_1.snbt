			title: "Dreamwood"
			x: 3.0d
			y: 3.0d
		}
		{
			dependencies: ["6C3C69F4EDB35C64"]
			description: [
				"Two pieces of Dreamwood, laid across each other."
				""
				"Small things first. You cannot hold a wand you have not made."
			]
